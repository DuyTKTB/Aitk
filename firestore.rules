rules_version = '2';

// ===============================================================
// firestore.rules — ELEC AI (chem-study)
// ===============================================================
// Nguyên tắc:
// • Tất cả người dùng đã đăng nhập (Học sinh & Giáo viên) có toàn quyền
//   tạo, làm bài, chấm điểm, quản lý lớp, đề thi, phòng thi và bài nộp.
// • Bảo vệ tài khoản người dùng và hệ thống mã kích hoạt PRO.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- HÀM DÙNG CHUNG --------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ===============================================================
    // 1. USERS — Hồ sơ người dùng
    // ===============================================================
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == resource.data.role ||
        isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. CLASSES — Lớp học
    // ===============================================================
    match /classes/{classId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 3. EXAMS — Đề thi & bài làm dở
    // ===============================================================
    match /exams/{examId} {
      allow read, create, update, delete: if signedIn();

      // Đáp án riêng tư của đề
      match /private/{docId} {
        allow read, write: if signedIn();
      }

      // Lần làm bài của học sinh
      match /attempts/{attemptId} {
        allow read, write, delete: if signedIn();
      }
    }

    // ===============================================================
    // 4. SUBMISSIONS — Bài nộp & Kết quả thi
    // ===============================================================
    match /submissions/{subId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 5. EXAM SESSIONS — Phòng thi trực tiếp (Live Proctoring)
    // ===============================================================
    match /examSessions/{sessionId} {
      allow read, create, update, delete: if signedIn();

      match /students/{studentId} {
        allow read, write, delete: if signedIn();
      }
    }

    // ===============================================================
    // 6. EXAM RETRY PERMITS — Đơn xin thi lại
    // ===============================================================
    match /examRetryPermits/{permitId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 7. STUDENT RETRY ALLOWANCE — Cấp quyền thi lại theo lớp
    // ===============================================================
    match /studentRetryAllowance/{allowanceId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 8. PRO KEYS & PRO USERS — Quản lý gói PRO
    // ===============================================================
    match /proKeys/{keyId} {
      allow read, write: if isAdmin();
    }

    match /proUsers/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 9. AI CHATS — Lịch sử hội thoại AI dự phòng
    // ===============================================================
    match /ai_chats/{chatId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

  }
}