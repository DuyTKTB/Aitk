rules_version = '2';

// ===============================================================
// firestore.rules — ELEC AI (chem-study)
// ===============================================================
// Nguyên tắc:
// • Tất cả người dùng đã đăng nhập (Học sinh & Giáo viên) có toàn quyền
//   tạo, làm bài, chấm điểm, quản lý lớp, đề thi, phòng thi và bài nộp.
// • Bảo vệ tài khoản người dùng và hệ thống mã kích hoạt PRO.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- HÀM DÙNG CHUNG --------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ===============================================================
    // 1. USERS — Hồ sơ người dùng
    // ===============================================================
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == resource.data.role ||
        isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 2. CLASSES — Lớp học
    // ===============================================================
    match /classes/{classId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 3. EXAMS — Đề thi & bài làm dở
    // ===============================================================
    match /exams/{examId} {
      allow read, create, update, delete: if signedIn();

      // Đáp án riêng tư của đề
      match /private/{docId} {
        allow read, write: if signedIn();
      }

      // Lần làm bài của học sinh
      match /attempts/{attemptId} {
        allow read, write, delete: if signedIn();
      }
    }

    // ===============================================================
    // 4. SUBMISSIONS — Bài nộp & Kết quả thi
    // ===============================================================
    match /submissions/{subId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 5. EXAM SESSIONS — Phòng thi trực tiếp (Live Proctoring)
    // ===============================================================
    match /examSessions/{sessionId} {
      allow read, create, update, delete: if signedIn();

      match /students/{studentId} {
        allow read, write, delete: if signedIn();
      }

      // ❗ FIX: ẢNH CAMERA nằm ở subcollection RIÊNG này
      //    (examSession.js: uploadThumbnailV2 + uploadBurst → examSessions/{sid}/media/{uid}).
      //    Firestore KHÔNG kế thừa rule của doc cha nên trước đây thiếu rule này:
      //    học sinh đẩy khung camera BỊ TỪ CHỐI (lỗi bị nuốt trong catch) và
      //    giáo viên đọc cũng bị chặn → ô camera trong Live Proctor đen thui.
      //    Đã xác minh bằng REST probe: write vào media trả 401/42501.
      match /media/{studentId} {
        allow read, write, delete: if signedIn();
      }
    }

    // ===============================================================
    // 6. EXAM RETRY PERMITS — Đơn xin thi lại
    // ===============================================================
    match /examRetryPermits/{permitId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 7. STUDENT RETRY ALLOWANCE — Cấp quyền thi lại theo lớp
    // ===============================================================
    match /studentRetryAllowance/{allowanceId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 8. PRO KEYS & PRO USERS — Quản lý gói PRO
    // ===============================================================
    match /proKeys/{keyId} {
      allow read, write: if isAdmin();
    }

    match /proUsers/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 9. AI CHATS — Lịch sử hội thoại AI dự phòng
    // ===============================================================
    match /ai_chats/{chatId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // 11. QUESTION BANK — Ngân hàng câu hỏi CÁ NHÂN của giáo viên
    //     ❗ FIX: trước đây thiếu rule cho collection 'questionBank' → mọi thao tác
    //     (đọc/thêm/sửa/xoá + "Lưu ngân hàng" từ AutoExamStudio) đều permission-denied
    //     → ngân hàng mãi trống. Mỗi GV chỉ đụng ngân hàng của chính mình (theo teacherId).
    // ===============================================================
    match /questionBank/{qid} {
      allow read, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherId == request.auth.uid
        && (!('teacherId' in request.resource.data) || request.resource.data.teacherId == request.auth.uid);
    }

    // ===============================================================
    // 10. PAPER EXAMS — Chấm phiếu trắc nghiệm A4 (OMR)
    // ===============================================================
    match /paperExams/{examId} {
      allow read, create, update, delete: if signedIn();

      match /results/{resId} {
        allow read, write, delete: if signedIn();
      }
    }

    // ===============================================================
    // 12. SOCIAL — Kết bạn / Lời mời / Tin nhắn riêng / Chat lớp
    // ===============================================================
    match /users/{uid}/friends/{friendId} {
      allow read: if isOwner(uid);
      allow create, delete: if isOwner(uid) || friendId == request.auth.uid;
    }

    match /users/{uid}/friendRequests/{fromUid} {
      /* Chủ hộ đọc/xóa hộp mời của mình; NGƯỜI GỬI được phép đọc lại lời mời mình đã gửi
         (dùng để kiểm tra "họ đã mời mình trước chưa" trong friendStatus) */
      allow read, delete: if isOwner(uid) || fromUid == request.auth.uid;
      allow create: if signedIn() && fromUid == request.auth.uid;
    }

    match /dms/{dmId} {
      /* Doc CHƯA TỒN TẠI (mở hội thoại mới) → resource.data là null → phải cho phép get
         để client kiểm tra rồi mới tạo */
      allow read, update, delete: if signedIn()
        && (!exists(/databases/$(database)/documents/dms/$(dmId))
            || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 20;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /classes/{classId}/chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 13. DUELS — Thách đấu quiz 1-1 realtime
    // ===============================================================
    match /duels/{duelId} {
      allow read, create, update, delete: if signedIn();
    }

    // ===============================================================
    // 14. LAB 3D — Phiên thực hành phòng lab 3D (chỉ chủ sở hữu)
    // ===============================================================
    match /users/{uid}/lab3dSessions/{sessionId} {
      allow read, write: if isOwner(uid);
    }

    // ===============================================================
    // 15. DOC STUDIO — Thư viện tài liệu (chỉ chủ sở hữu)
    // ===============================================================
    match /users/{uid}/docStudioDocs/{docId} {
      allow read, write: if isOwner(uid);
    }

  }
}