{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aitk-ten.vercel.app"
        }
      ],
      "destination": "https://www.elecai.id.vn/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://duyheheh-2a269.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://duyheheh-2a269.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/nha-sang-lap",
      "destination": "/nha-sang-lap.html"
    },
    {
      "source": "/gioi-thieu",
      "destination": "/gioi-thieu.html"
    },
    {
      "source": "/chinh-sach-bao-mat",
      "destination": "/chinh-sach-bao-mat.html"
    },
    {
      "source": "/dieu-khoan-su-dung",
      "destination": "/dieu-khoan-su-dung.html"
    },
    {
      "source": "/tro-ly-ai-giai-hoa",
      "destination": "/tro-ly-ai-giai-hoa.html"
    },
    {
      "source": "/phong-thi-ao",
      "destination": "/phong-thi-ao.html"
    },
    {
      "source": "/bang-tuan-hoan",
      "destination": "/bang-tuan-hoan.html"
    },
    {
      "source": "/can-bang-phuong-trinh-hoa-hoc",
      "destination": "/can-bang-phuong-trinh-hoa-hoc.html"
    },
    {
      "source": "/lo-trinh-on-thi-thpt-quoc-gia",
      "destination": "/lo-trinh-on-thi-thpt-quoc-gia.html"
    },
    {
      "source": "/cong-thuc-hoa-hoc",
      "destination": "/cong-thuc-hoa-hoc.html"
    },
    {
      "source": "/tai-lieu-hoa-hoc",
      "destination": "/tai-lieu-hoa-hoc.html"
    },
    {
      "source": "/tinh-diem-xet-tuyen-dai-hoc",
      "destination": "/tinh-diem-xet-tuyen-dai-hoc.html"
    },
    {
      "source": "/tra-cuu-diem-chuan",
      "destination": "/tra-cuu-diem-chuan.html"
    },
    {
      "source": "/dinh-huong-nghe-nghiep",
      "destination": "/dinh-huong-nghe-nghiep.html"
    },
    {
      "source": "/tro-choi-khoa-hoc",
      "destination": "/tro-choi-khoa-hoc.html"
    },
    {
      "source": "/ai-doc-studio",
      "destination": "/ai-doc-studio.html"
    },
    {
      "source": "/bang-phan-tuong-tac",
      "destination": "/bang-phan-tuong-tac.html"
    },
    {
      "source": "/quiz",
      "destination": "/quiz.html"
    },
    {
      "source": "/bang-xep-hang",
      "destination": "/bang-xep-hang.html"
    },
    {
      "source": "/((?!api/|assets/|img/|video/|__/auth/|__/firebase/|robots\\.txt|sitemap\\.xml|llms\\.txt|BingSiteAuth\\.xml|nha-sang-lap(?:\\.html)?|gioi-thieu(?:\\.html)?|chinh-sach-bao-mat(?:\\.html)?|dieu-khoan-su-dung(?:\\.html)?|tro-ly-ai-giai-hoa(?:\\.html)?|phong-thi-ao(?:\\.html)?|bang-tuan-hoan(?:\\.html)?|can-bang-phuong-trinh-hoa-hoc(?:\\.html)?|lo-trinh-on-thi-thpt-quoc-gia(?:\\.html)?|cong-thuc-hoa-hoc(?:\\.html)?|tai-lieu-hoa-hoc(?:\\.html)?|tinh-diem-xet-tuyen-dai-hoc(?:\\.html)?|tra-cuu-diem-chuan(?:\\.html)?|dinh-huong-nghe-nghiep(?:\\.html)?|tro-choi-khoa-hoc(?:\\.html)?|ai-doc-studio(?:\\.html)?|bang-phan-tuong-tac(?:\\.html)?|quiz(?:\\.html)?|bang-xep-hang(?:\\.html)?|manifest\\.json|manifest\\.webmanifest|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://challenges.cloudflare.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https://duyheheh-2a269.firebaseapp.com; object-src 'none'; base-uri 'self';" }
      ]
    }
  ]
}
