# Cấu hình môi trường — ELEC AI
# Sao chép file này thành .env rồi điền giá trị thật.
# Biến VITE_* được nhúng vào bundle phía client: chỉ dùng key phía client khi bạn chấp nhận
# rủi ro bị lộ; muốn giấu key hãy chuyển sang Cloud Function (src/lib/functionsClient.js).

# ---------- Firebase ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Supabase (lịch sử chat) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Provider AI (BỎ - Dùng Cloud Functions) ----------
# ❌ KHÔNG lưu API keys ở client (.env)
# ✅ API keys được lưu ở Google Cloud Secret Manager
# ✅ Client gọi Cloud Function proxy (src/lib/aiClient.js)
# 
# Để setup:
# 1. Lưu API keys ở Google Cloud Secret Manager
# 2. Deploy Cloud Function (functions/aiProxy.js)
# 3. Cập nhật VITE_FUNCTIONS_ENDPOINT dưới đây

# ---------- Tinh chỉnh lớp AI (tùy chọn) ----------
# Ghi đè danh sách model theo tầng (ngăn cách bằng dấu phẩy)
# VITE_AI_MODEL_FAST=gemini-2.5-flash-lite
# VITE_AI_MODEL_SMART=gemini-2.5-pro,gemini-2.5-flash
# VITE_AI_MODEL_VISION=gemini-2.5-flash
# Tắt suy luận sâu / cache / OCR dự phòng
# VITE_AI_THINKING=0
# VITE_AI_CACHE=0
# VITE_AI_OCR=0
# VITE_AI_DISCOVER_MODELS=0
# Chạy song song 2 provider để giảm độ trễ (tốn thêm request)
# VITE_AI_HEDGE_MS=1400
# Mức an toàn của Gemini: educational (mặc định) | strict
# VITE_AI_SAFETY=educational
# Vùng Cloud Functions
VITE_FUNCTIONS_ENDPOINT=https://us-central1-your-project-id.cloudfunctions.net/askAI
# VITE_FUNCTIONS_REGION=us-central1

# ---------- Phản hồi người dùng (tùy chọn) ----------
# VITE_FEEDBACK_URL=
# Danh sách email admin (chỉ dùng làm fallback hiển thị)
# VITE_ADMIN_EMAILS=
