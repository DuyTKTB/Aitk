rules_version = '2';

// ===============================================================
// firestore.rules — ELEC AI (chem-study) — BẢN ĐÃ SỬA
// ---------------------------------------------------------------
// Đã đối chiếu với code thật trong src/lib/*.js:
//   • classes:  name, key, teacherId, teacherName, members[], memberIds[],
//               pendingMembers[], pendingIds[], requireApproval
//   • examSessions: teacherId, stats{joined, submitted, violationCount}
//   • studentRetryAllowance: {classId}_{studentId} → classId (KHÔNG có sessionId)
//   • proKeys / proUsers: client tự kích hoạt key (src/lib/teacherPro.js)
//   • users/{uid}/friends, /friendRequests: ghi chéo giữa 2 user
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- HÀM DÙNG CHUNG --------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isClassTeacher(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isExamTeacher(examId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/exams/$(examId)) &&
        get(/databases/$(database)/documents/exams/$(examId)).data.teacherId == request.auth.uid;
    }

    function isSessionTeacher(sessionId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/examSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/examSessions/$(sessionId)).data.teacherId == request.auth.uid;
    }

    // Danh sách MỚI = cũ + đúng 1 phần tử, và phần tử thêm vào là chính mình
    function gainedSelf(oldIds, newIds) {
      return newIds.size() == oldIds.size() + 1
        && newIds.hasAll(oldIds)
        && (request.auth.uid in newIds)
        && !(request.auth.uid in oldIds);
    }

    // Danh sách MỚI = cũ - đúng 1 phần tử, và phần tử bị bỏ là chính mình
    function lostSelf(oldIds, newIds) {
      return newIds.size() == oldIds.size() - 1
        && oldIds.hasAll(newIds)
        && (request.auth.uid in oldIds)
        && !(request.auth.uid in newIds);
    }

    // ===============================================================
    // 1. USERS — Hồ sơ người dùng & Dữ liệu con
    // ===============================================================
    match /users/{uid} {
      allow read: if signedIn();
      // Chặn tự đăng ký role 'admin' ngay lúc tạo hồ sơ
      allow create: if isOwner(uid) && (
        !('role' in request.resource.data) ||
        request.resource.data.role in ['student', 'teacher', 'user']
      );
      allow update: if (isOwner(uid) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == resource.data.role ||
        isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // Áp dụng cho lab3dSessions, docStudioDocs, ... (dữ liệu riêng của chủ hộ)
    match /users/{uid}/{path=**} {
      allow read, write: if isOwner(uid);
    }

    // Kết bạn: A ghi vào hộp của B với docId = uid của A → buộc phải cho phép chéo
    match /users/{uid}/friends/{friendId} {
      allow read, create, delete: if isOwner(uid) || friendId == request.auth.uid;
      allow update: if isOwner(uid);
    }

    match /users/{uid}/friendRequests/{fromUid} {
      allow read, delete: if isOwner(uid) || fromUid == request.auth.uid;
      allow create: if signedIn() && fromUid == request.auth.uid;
    }

    // ===============================================================
    // 2. CLASSES — Lớp học
    // ===============================================================
    match /classes/{classId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid;

      // GV sở hữu lớp: toàn quyền.
      // HS: chỉ được thay đổi 4 mảng thành viên (join ngay / xin chờ duyệt / rời lớp / huỷ).
      // Tên lớp, mã lớp (key), giáo viên… đều KHÔNG nằm trong hasOnly → không sửa được.
      allow update: if signedIn() && (
        resource.data.teacherId == request.auth.uid ||
        (
          request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberIds', 'pendingMembers', 'pendingIds', 'updatedAt', 'joinedAt'])
          // Muốn chặt hơn (chặn HS xoá thành viên khác), thêm:
          //   && gainedSelf('pendingIds' in resource.data ? resource.data.pendingIds : [],
          //                 'pendingIds' in request.resource.data ? request.resource.data.pendingIds : [])
        )
      );
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // Chat lớp
      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // ===============================================================
    // 3. EXAMS — Đề thi & bài làm dở (attemptId = {examId}_{uid})
    // ===============================================================
    match /exams/{examId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // Đáp án riêng tư của đề — chỉ giáo viên của đề
      match /private/{docId} {
        allow read, write: if isExamTeacher(examId);
      }

      // Lần làm bài
      match /attempts/{attemptId} {
        allow read: if signedIn() && (
          attemptId == examId + '_' + request.auth.uid || isExamTeacher(examId)
        );
        allow create, update: if signedIn() && (
          attemptId == examId + '_' + request.auth.uid || isExamTeacher(examId)
        );
        allow delete: if isExamTeacher(examId);
      }
    }

    // ===============================================================
    // 4. SUBMISSIONS — Bài nộp & Kết quả thi
    // ===============================================================
    match /submissions/{subId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid || isExamTeacher(resource.data.examId)
      );
      // HS chỉ tạo bài của chính mình, dùng serverTimestamp()
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.submittedAt == request.time;
      // HS ghi đè đúng bài của mình (setDoc lại cùng subId khi mạng lỗi / nộp lại)
      allow update: if signedIn() && (
        isExamTeacher(resource.data.examId) ||
        (
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'detail', 'score', 'correctCount', 'totalPoints', 'totalQuestions',
            'timeSpent', 'submittedAt', 'graded', 'autoSubmitted', 'violationCount',
            'cameraStatus', 'isRetry'
          ])
        )
      );
      allow delete: if signedIn() && isExamTeacher(resource.data.examId);
    }

    // ===============================================================
    // 5. EXAM SESSIONS — Phòng thi trực tiếp (Live Proctoring)
    // ===============================================================
    match /examSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;

      allow update: if signedIn() && (
        resource.data.teacherId == request.auth.uid ||
        (
          // HS trong phòng thi: chỉ được +1 vào 3 bộ đếm trong stats
          // (join / violation / submitted) — không sửa gì khác
          resource.data.teacherId == request.resource.data.teacherId
          && ('stats' in resource.data) && ('stats' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
          && request.resource.data.stats.diff(resource.data.stats).affectedKeys()
               .hasOnly(['joined', 'violationCount', 'submitted'])
          && (
            request.resource.data.stats.joined + request.resource.data.stats.violationCount
              + request.resource.data.stats.submitted
            == resource.data.stats.joined + resource.data.stats.violationCount
              + resource.data.stats.submitted + 1
          )
        )
      );
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // Hồ sơ từng học sinh
      match /students/{studentId} {
        allow read: if signedIn() && (studentId == request.auth.uid || isSessionTeacher(sessionId));
        allow create, update: if signedIn() && (studentId == request.auth.uid || isSessionTeacher(sessionId));
        allow delete: if signedIn() && isSessionTeacher(sessionId);
      }

      // Ảnh camera
      match /media/{studentId} {
        allow read: if signedIn() && (studentId == request.auth.uid || isSessionTeacher(sessionId));
        allow create, update: if signedIn() && (studentId == request.auth.uid || isSessionTeacher(sessionId));
        allow delete: if signedIn() && isSessionTeacher(sessionId);
      }
    }

    // ===============================================================
    // 6. EXAM RETRY PERMITS — Đơn xin thi lại
    // ===============================================================
    match /examRetryPermits/{permitId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isExamTeacher(resource.data.examId)
      );
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && (isAdmin() || isExamTeacher(resource.data.examId));
    }

    // ===============================================================
    // 7. STUDENT RETRY ALLOWANCE — Cấp quyền thi lại (docId = {classId}_{uid})
    //    Field thật: classId, studentId, allowed, updatedAt, updatedBy
    //    → KHÔNG có sessionId, không dùng isSessionTeacher ở đây
    // ===============================================================
    match /studentRetryAllowance/{allowanceId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isAdmin() || isClassTeacher(request.resource.data.classId)
      );
      allow update, delete: if signedIn() && (
        isAdmin() || isClassTeacher(resource.data.classId)
      );
    }

    // ===============================================================
    // 8. PRO KEYS & PRO USERS — Quản lý gói PRO
    //    Client tự kích hoạt key (teacherPro.js) nên cần đọc proKeys
    //    và tự ghi proUsers/{uid} của mình.
    // ===============================================================
    match /proKeys/{keyId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && (!('usedBy' in resource.data) || resource.data.usedBy == null || resource.data.usedBy == request.auth.uid)
      );
    }

    match /proUsers/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // 9. AI CHATS — Lịch sử hội thoại AI dự phòng
    // ===============================================================
    match /ai_chats/{chatId} {
      allow read, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // 10. QUESTION BANK — Ngân hàng câu hỏi cá nhân
    // ===============================================================
    match /questionBank/{qid} {
      allow read, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherId == request.auth.uid
        && (!('teacherId' in request.resource.data) || request.resource.data.teacherId == request.auth.uid);
    }

    // ===============================================================
    // 11. PAPER EXAMS — Chấm phiếu trắc nghiệm A4 (OMR)
    // ===============================================================
    match /paperExams/{examId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      match /results/{resId} {
        allow read: if signedIn();
        allow write, delete: if signedIn() &&
          get(/databases/$(database)/documents/paperExams/$(examId)).data.teacherId == request.auth.uid;
      }
    }

    // ===============================================================
    // 12. SOCIAL — Tin nhắn riêng
    // ===============================================================
    match /dms/{dmId} {
      allow read, update, delete: if signedIn()
        && (!exists(/databases/$(database)/documents/dms/$(dmId))
            || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 20;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // ===============================================================
    // 13. DUELS — Thách đấu quiz 1-1 realtime
    // ===============================================================
    match /duels/{duelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players ||
        request.auth.uid in request.resource.data.players
      );
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }
  }
}
